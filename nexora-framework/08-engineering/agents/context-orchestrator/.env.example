# Nexora Framework local runtime example.
# Copy values to your OS environment or to a local .env file that remains ignored by git.

# Repository and project paths
NEXORA_ROOT=C:/Documents/Proyectos/Laboratorio/NEXORA/git/nexora
NEXORA_PROJECT_PATH=projects/healthcare-operations-platform
NEXORA_ACTIVE_PROMPT_DIR=projects/healthcare-operations-platform/08-qa/generated-prompts/active_prompt
NEXORA_QUOTA_TRACKER=.nexora/runtime/quota_tracker.json

# Local Ollama routing
NEXORA_OLLAMA_MODEL=qwen2.5-coder:0.5b
NEXORA_EXECUTION_FLOW=manual

# Subscription/local execution routing. These files are ignored by git.
NEXORA_AGENT_TASK_FILE=.agent_next_task.md
NEXORA_AGENT_RESULT_FILE=.agent_task_summary.md

# Optional subscription-backed CLI providers. Configure CLI login outside the repository.
# claude CLI must be available in PATH when claude_code_cli is enabled in quota_tracker.json.
# codex CLI must be available in PATH and authenticated with `codex login` when codex_cli is enabled.
# gh CLI with GitHub Copilot extension must be available in PATH when github_copilot_cli is enabled.
# gemini CLI must be available in PATH and OAuth/enterprise eligible when gemini_cli is enabled.
# kiro CLI must be available in PATH when kiro_ide_cli is enabled for IDE task handoff.
