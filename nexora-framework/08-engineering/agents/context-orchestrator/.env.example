# Nexora Framework local runtime example.
# Copy values to your OS environment or to a local .env file that remains ignored by git.

# Repository and project paths
NEXORA_ROOT=C:/Documents/Proyectos/Laboratorio/NEXORA/git/nexora
NEXORA_PROJECT_PATH=projects/healthcare-operations-platform
NEXORA_ACTIVE_PROMPT_DIR=projects/healthcare-operations-platform/08-qa/generated-prompts/active_prompt
NEXORA_QUOTA_TRACKER=.nexora/runtime/quota_tracker.json

# Local Ollama routing
NEXORA_OLLAMA_MODEL=qwen2.5-coder:0.5b

# Optional commercial providers. Leave unset when not used.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional CLI provider. Configure the CLI login outside the repository.
# claude CLI must be available in PATH when claude_code_cli is enabled in quota_tracker.json.
