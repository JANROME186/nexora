{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.local/schemas/artifact-node.schema.json",
  "title": "Nexora Artifact Node",
  "type": "object",
  "required": ["id", "name", "type", "status", "version", "owner", "source_path"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "type": {"type": "string"},
    "status": {"type": "string", "enum": ["draft", "review", "approved", "deprecated", "removed"]},
    "version": {"type": "string"},
    "owner": {"type": "string"},
    "source_path": {"type": "string"},
    "description": {"type": "string"},
    "related_nodes": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "downstream": {"type": "array", "items": {"type": "string"}}
  }
}
