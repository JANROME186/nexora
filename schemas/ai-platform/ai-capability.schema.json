{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.dev/schemas/ai-capability.schema.json",
  "title": "Nexora AI Capability",
  "type": "object",
  "required": ["id", "name", "category", "provider_agnostic", "requires_human_review"],
  "properties": {
    "id": { "type": "string", "pattern": "^AI-CAP-[0-9]{3}$" },
    "name": { "type": "string" },
    "category": { "type": "string" },
    "provider_agnostic": { "type": "boolean" },
    "requires_human_review": { "oneOf": [{"type": "boolean"}, {"type": "string"}] },
    "fallback": { "type": "string" },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
  }
}
