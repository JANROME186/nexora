{
  "name": "hop-mobile-app",
  "private": true,
  "version": "0.1.0",
  "description": "Healthcare Operations Platform mobile app foundation for MVP-MOD-001 Platform Foundation.",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck",
    "duplication": "jscpd --config jscpd.config.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md}\"",
    "lint": "eslint \"src/**/*.ts\" --config eslint.config.js",
    "quality": "npm run typecheck && npm run lint && npm run test:coverage && npm run duplication && npm run format:check",
    "test": "vitest run --config vitest.config.mjs",
    "test:coverage": "vitest run --config vitest.config.mjs --coverage",
    "typecheck": "tsc -p tsconfig.json"
  },
  "overrides": {
    "minimatch": "10.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.5.0",
    "jscpd": "^4.0.5",
    "prettier": "^3.7.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.7"
  }
}
